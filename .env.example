# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API (Meta App → WhatsApp → API Setup) ---
WHATSAPP_TOKEN=                # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=      # the SHIFT number's phone number ID
WHATSAPP_APP_SECRET=           # Meta App → Settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=         # any random string; paste the same into the webhook setup
WHATSAPP_TEMPLATE_LANG=en
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX   # SHIFT number in international format, digits only (for wa.me links)

# --- Supabase "Send SMS" auth hook → delivers login codes on WhatsApp ---
SEND_SMS_HOOK_SECRET=          # v1,whsec_... shown when you create the hook

# --- Coach ---
COACH_NAME=Nandita
COACH_WHATSAPP=                # Nandita's own WhatsApp, digits only (optional: new-client alerts)

# --- Scheduled messages (Vercel sets the header automatically when this is defined) ---
CRON_SECRET=

# --- AI (optional; without it, meals are matched against the built-in Indian food table) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://shiftbynandita.com   # until the domain is live: https://shiftbynandita.vercel.app
